{
  "name": "@loranrendel/versoly-ui",
  "version": "3.0.0",
  "description": "Versoly UI - Tailwind CSS 4 framework based on Bootstrap",
  "keywords": [
    "bootstrap to tailwind",
    "dropdown Floating UI",
    "tailwind components",
    "tailwind elements",
    "tailwind library",
    "tailwind plugin",
    "tailwind sections",
    "tailwind ui",
    "tailwindcss 4",
    "ui kit"
  ],
  "homepage": "https://github.com/LoranRendel/versoly-ui-tailwind4#readme",
  "bugs": {
    "url": "https://github.com/LoranRendel/versoly-ui-tailwind4/issues"
  },
  "license": "MIT",
  "author": "Versoly",
  "contributors": [
    "Volkan Kaya <volkan@versoly.com>",
    "Loran A. Rendel <main@enjoytool.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoranRendel/versoly-ui-tailwind4.git"
  },
  "type": "module",
  "main": "./dist/versoly-ui.cjs",
  "module": "./dist/versoly-ui.mjs",
  "unpkg": "dist/versoly-ui.iife.js",
  "jsdelivr": "dist/versoly-ui.iife.js",
  "exports": {
    ".": {
      "import": "./dist/versoly-ui.mjs",
      "require": "./dist/versoly-ui.cjs"
    },
    "./plugin": {
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "pnpm run build",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.20.3",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2",
    "vite": "v8.0.0-beta.13"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
